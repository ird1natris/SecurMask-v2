NODE_ENV=development
PORT=8081
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classifile
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
FLASK_URL=http://127.0.0.1:5000
PROCESSOR_SECRET=replace-with-another-random-secret-at-least-32-characters
# In production mount the API volume here:
# UPLOAD_DIR=/data/uploads
EMAIL_PROVIDER=resend
EMAIL_FROM=Classifile <noreply@your-verified-domain.example>
RESEND_API_KEY=
# Optional SMTP alternative (Railway Pro or above):
# EMAIL_PROVIDER=smtp
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASS=
RECAPTCHA_SECRET_KEY=
