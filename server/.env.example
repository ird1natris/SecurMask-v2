# Local example. In Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securmask
SECRET_KEY=replace-with-a-long-random-secret
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
RECAPTCHA_SECRET_KEY=

# Local default is server/uploads. On Railway use the mounted directory.
# UPLOAD_DIR=/data/uploads
FLASK_URL=http://127.0.0.1:5000
