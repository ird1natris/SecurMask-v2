FROM python:3.12-slim
WORKDIR /app
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY server/main_app.py .
ENV NODE_ENV=production PYTHONUNBUFFERED=1 PORT=5000
EXPOSE 5000
CMD ["gunicorn", "main_app:main_app", "--bind", "[::]:5000", "--workers", "1", "--threads", "1", "--timeout", "120"]
